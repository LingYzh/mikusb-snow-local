# This repository contains the reproducible local-server source and setup tools.
# A normal game client and all locally generated runtime state stay outside Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/HANDOFF.md
!/Setup-LocalWorkspace.ps1
!/Start-LocalServer.cmd
!/Start-LocalGame.cmd
!/Configure-LocalLoginRouting.ps1
!/MikuSB/
!/MikuSB/**

# Runtime output produced by Setup-LocalWorkspace.ps1.
/Server/
/Patches/
/Tools/
/MikuSB/Tools/
/Captured_Packets/
/data/
/.agents/

# Root-level generated launchers and legacy local helpers.
/*.exe
/*.dll
/*.json
/*.bat
/*.js
/*.txt
/*.zip
/*.pak
/*.ucas
/*.utoc

# Keep the portable, source-controlled entry points above even though their
# extensions are otherwise ignored.
!/Configure-LocalLoginRouting.ps1
!/Start-LocalServer.cmd
!/Start-LocalGame.cmd
